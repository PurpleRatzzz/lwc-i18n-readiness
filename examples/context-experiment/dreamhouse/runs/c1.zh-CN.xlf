        <source>Click</source>
        <target state="translated">单击</target>
        <note from="developer" annotates="general">Click</note>
      </trans-unit>
      <trans-unit id="DH_Scanner_Rest">
        <source>to open a QR Code scanner camera view. Position a QR Code in the scanner view to scan it.</source>
        <target state="translated">以打开二维码扫描器相机视图。请将二维码置于扫描器视图中进行扫描。</target>
        <note from="developer" annotates="general">to open a QR Code scanner camera view. Position a QR Code in the scanner view to scan it.</note>
      </trans-unit>
